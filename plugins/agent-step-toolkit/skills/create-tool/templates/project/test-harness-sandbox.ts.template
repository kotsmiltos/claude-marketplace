// FILE: src/test-harness/sandbox.ts
//
// Generic sandbox-test scaffolding, shared by every tool's tests/tool/ suite.
// Tool-agnostic: it knows nothing about a specific backend. Per-tool wiring
// (which backend to reset, which seed, the initial state) lives in each tool's
// tests/tool/_setup.ts, which builds on these helpers.
//
// THIS LAYER NEVER TOUCHES THE LLM. Sandbox tests prove the runner + executors
// behave correctly given EXPLICIT step batches. The question they answer is
// "given these steps, do the runner + executors do the right thing?" — not
// "what steps would the model emit?" (that is the prompt-input layer).
//
// What sandbox tests assert (via the re-exports below):
//   - body.results[i].ok / .verdict   — the executor's outcome
//   - body.failed_at                  — the short-circuit index, or undefined
//   - committed.<slot>                — state mutations the runner accepted
// What they must NOT assert: anything about tool_calls or LLM wording.

import assert from "node:assert/strict";
import { runSteps } from "../agent-step/index.js";
import type {
  BuildAgentStepToolOptions,
  RunResult,
  LibraryManagedSlots,
} from "../agent-step/index.js";

// Re-exported so tool tests import everything they need from one place
// (their _setup.ts) and never reach into runner internals.
export { runSteps, assert };
export type { BuildAgentStepToolOptions, RunResult };

/** Fold a batch's committed updates into the starting state for the next batch,
 *  mirroring what the graph does between turns. Shallow merge is correct for
 *  replace-on-write slots (the library default for awaitingInput / currentFlow
 *  and most per-tool slots). For record-merge slots (e.g.
 *  `Record<string, X>` accumulated by key across turns) override this in the
 *  tool's _setup.ts with a slot-aware merge. */
export function foldCommitted<T extends LibraryManagedSlots>(
  prev: T,
  committed: Partial<T>,
): T {
  return { ...prev, ...committed };
}

/** Assert the local sandbox backend is reachable before a suite runs. Call in a
 *  `before` hook. Pass the SAME base-url the executors use (read from the tool's
 *  env) so the test routes at exactly what production code hits. A connection
 *  refusal throws with a fix-it message; any HTTP response (even 404) counts as
 *  reachable — we only care that the server answered. */
export async function requireReachable(
  baseUrl: string,
  opts: { path?: string; timeoutMs?: number } = {},
): Promise<void> {
  const url = `${baseUrl}${opts.path ?? "/"}`;
  try {
    await fetch(url, { signal: AbortSignal.timeout(opts.timeoutMs ?? 2000) });
  } catch (err) {
    throw new Error(
      `sandbox unreachable at ${url} — start the local sandbox and point the ` +
        `tool's *_BASE_URL env at it before running sandbox tests. ` +
        `Original: ${(err as Error).message}`,
    );
  }
}

/** Generic HTTP reset helper. Many local sandboxes expose a reset/seed endpoint;
 *  POST the seed to it in a `before` hook so every suite starts from the same
 *  known state. Tools whose sandbox resets differently should implement their
 *  own reset in _setup.ts instead of calling this. */
export async function resetViaHttp(url: string, body?: unknown): Promise<void> {
  const res = await fetch(url, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: body === undefined ? undefined : JSON.stringify(body),
  });
  if (!res.ok) {
    throw new Error(
      `sandbox reset failed (${res.status}) at ${url}: ${(await res.text()).slice(0, 300)}`,
    );
  }
}

// ─── Confirmation gates across caller turns ──────────────────────────────────
//
// The runner stamps every confirmation proposal with the caller turn it was
// proposed on and REFUSES a matching re-call on that same turn
// (`confirmation_same_turn_locked`) — execution requires the caller to have
// actually answered on a later turn. Tests that drive the propose → execute
// handshake by hand must therefore simulate the answering turn: append a fresh
// human message id between the two calls. These helpers do exactly that.
// (The guard keys on the latest human/user message id — or the host's
// `getCallerTurnId` — and is inert when the state carries no such identity.)

let confirmTurnSeq = 0;

/** A minimal human-message stand-in carrying exactly what the runner's default
 *  caller-turn resolution reads (`type: "human"` + a stable `id`). Real
 *  `HumanMessage` instances work identically; this avoids constructing
 *  LangChain messages in state fixtures. */
export function callerTurn(id: string): { type: string; id: string; content: string } {
  return { type: "human", id, content: "(caller turn)" };
}

/** Return `state` with a fresh caller turn appended — "the caller answered".
 *  Thread a manual propose → execute sequence through this between the two
 *  `runSteps` calls, exactly as a real conversation would (the same-turn
 *  re-call is refused by design). */
export function answeredTurn<T extends LibraryManagedSlots & { messages?: unknown[] }>(
  state: T,
): T {
  return {
    ...state,
    messages: [...(state.messages ?? []), callerTurn(`answer-${++confirmTurnSeq}`)],
  };
}

/** Drive a confirm-gated action through the runner's propose → execute
 *  handshake ACROSS TWO CALLER TURNS, the way production works: the proposal
 *  lands on one caller turn, a fresh human message (the caller's "yes")
 *  arrives, and only then does the matching re-call execute. Returns the
 *  EXECUTE call's body plus the state threaded through BOTH calls. Throws if
 *  the first call did not propose (e.g. a prereq denial) so tests fail loudly
 *  at the right step. Pass the tool's `toolOpts` bundle; override `fold` when
 *  a slot needs a merge smarter than the shallow `foldCommitted`. */
export async function runConfirmed<T extends LibraryManagedSlots & { messages?: unknown[] }>(
  opts: unknown,
  action: string,
  params: Record<string, unknown>,
  state: T,
  fold: (prev: T, committed: Partial<T>) => T = foldCommitted,
): Promise<{ body: RunResult<T>["body"]; committed: Partial<T>; state: T }> {
  const seq = ++confirmTurnSeq;
  const proposeState: T = {
    ...state,
    messages: [...(state.messages ?? []), callerTurn(`confirm-turn-${seq}-ask`)],
  };
  const propose = await runSteps(
    opts as never,
    [{ action, params }],
    proposeState as never,
  );
  const first = propose.body.results[0] as { needs_confirmation?: boolean } | undefined;
  if (first?.needs_confirmation !== true) {
    throw new Error(
      `runConfirmed: expected a proposal for "${action}", got ${JSON.stringify(propose.body)}`,
    );
  }
  const mid = fold(proposeState, propose.committed as Partial<T>);
  const answered: T = {
    ...mid,
    messages: [...(mid.messages ?? []), callerTurn(`confirm-turn-${seq}-yes`)],
  };
  const execute = await runSteps(opts as never, [{ action, params }], answered as never);
  return {
    body: execute.body as RunResult<T>["body"],
    committed: execute.committed as Partial<T>,
    state: fold(answered, execute.committed as Partial<T>),
  };
}
