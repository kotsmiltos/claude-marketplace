// FILE: src/prompt.ts
//
// System prompt builder. Rebuilt every turn with `today` injected.
// Structured into sections — each tool added via /create-tool extends the
// SCOPE and ACTIONS sections and wires the TURN PROTOCOL splice below.
//
// The MACHINERY text (tool turn vs speaking turn, the gate handshake,
// read-back authority, handoff silence) is ENGINE-COMPOSED: once the first
// tool exists, `composeProtocolPrompt` renders it from the tool's feature
// surface and this file splices it verbatim at {PROTOCOL}. Hosts write NONE
// of that text themselves — domain capture doctrines that must outrank the
// generic contracts go on `toolTurnRules`. This module must stay env-free
// (import the tool's config/contracts, never its executors).

import type { BaseMessageLike } from "@langchain/core/messages";
import type { State } from "./state.js";
// {{Once the first tool exists, uncomment and adapt (see create-tool.md):}}
// import { composeProtocolPrompt } from "./agent-step/index.js";
// import { {{TOOL_NAME}}Config } from "./tools/{{TOOL_NAME}}/config.js";
// import { {{TOOL_NAME}}Ladders } from "./tools/{{TOOL_NAME}}/contracts.js"; // if ladders configured
// import { handoffSpec } from "./handoff-spec.js"; // if handoff configured

function todayIso(): string {
  return new Date().toISOString().slice(0, 10);
}

