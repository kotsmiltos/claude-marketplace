// FILE: src/tools/{{TOOL_NAME}}/actions/{{ACTION_NAME}}/executor.ts
//
// Mutation executor. Handles its own pre-check and post-read internally, and
// NAMES each outcome's verdict — summaries, doctrine, error codes, and any
// terminal handoff live in the action's declared `verdicts` rows (see
// ./action.ts), so the wire body can never fork from the declaration.
// The library only manages the propose → execute lifecycle around this
// executor; on execute mode this executor is invoked once with the matching
// params.

import { postBackend } from "../../backend/client.js";
import { {{TOOL_NAME}}Env } from "../../backend/env.js";
import type { State } from "../../../../state.js";
import type { DeclaredExecutorResult } from "../../../../agent-step/index.js";
import type { Slice } from "./stateSelector.js";

interface {{ACTION_PARAMS_TYPE}} {
  // {{PARAM_FIELDS}}
}

// ─── Helper: read current state (used by both pre-check and post-read) ──── //
async function read{{ENTITY}}State({{ENTITY_ID}}: string): Promise<string> {
  const resp = await postBackend<{ payload?: { state?: string } }>(
    {{TOOL_NAME}}Env.{{BASE_URL_FIELD}},
    "{{READ_STATE_ENDPOINT}}",
    {
      // {{READ_REQUEST_FIELDS}}
    },
    { envelope: "{{ENVELOPE_MODE}}" },
  );
  return resp?.payload?.state ?? "unknown";
}

// `state` is the SLICE this action's stateSelector returned — not the whole
// state. Read only what the selector handed you. The result's `stateUpdate`,
// though, may still patch any host slot (DeclaredExecutorResult<State>).
export async function {{EXECUTOR_FN_NAME}}(
  rawParams: unknown,
  state: Slice,
): Promise<DeclaredExecutorResult<State>> {
  const p = rawParams as {{ACTION_PARAMS_TYPE}};

  // ─── Pre-read: decide whether the mutation should happen ──────────────── //
  const preState = await read{{ENTITY}}State(/* entity.id */ "{{ENTITY_ID_VALUE}}");
  if ({{REFUSE_CONDITION}}) {
    // Row `mutation_blocked` carries the static summary/error; the observed
    // pre-state rides `data` for the row's function fields, and
    // `resultExtras` appends raw fields after the declared body.
    return {
      verdict: "mutation_blocked",
      data: { preState },
      resultExtras: { preState },
    };
  }

  // ─── Write ────────────────────────────────────────────────────────────── //
  const resp = await postBackend<{ payload?: { success?: boolean } }>(
    {{TOOL_NAME}}Env.{{WRITE_BASE_URL_FIELD}},
    "{{WRITE_ENDPOINT}}",
    {
      // {{WRITE_REQUEST_FIELDS}}
    },
    { envelope: "{{ENVELOPE_MODE}}" },
  );

  const success = resp?.payload?.success === true;
  if (!success) {
    return {
      verdict: "write_failed",
      resultExtras: { preState },
    };
  }

  // ─── Post-read: verify the write landed ───────────────────────────────── //
  const postState = await read{{ENTITY}}State(/* entity.id */ "{{ENTITY_ID_VALUE}}");

  return {
    verdict: "ok",
    data: { postState },
    // stateUpdate: { {{OUTCOME_SLOT}}: ... },  // dynamic writes only — static
    //                                          // ones belong on the row
    resultExtras: { preState, postState },
  };
}
